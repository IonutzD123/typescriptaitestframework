{
  "consumer": {
    "name": "PlaywrightConsumer"
  },
  "interactions": [
    {
      "description": "a request for post 1",
      "providerStates": [
        {
          "name": "post with ID 1 exists"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/posts/1"
      },
      "response": {
        "body": {
          "body": "example body",
          "id": 1,
          "title": "example title",
          "userId": 1
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.body": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.title": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.userId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "16.4.0"
    },
    "pactRust": {
      "ffi": "0.5.4",
      "models": "1.3.11"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "JsonPlaceholderProvider"
  }
}